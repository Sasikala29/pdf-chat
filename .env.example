# Groq API key: provide your own key in the local .env file.
GROQ_API_KEY=

# Model used to generate answers from the retrieved PDF context.
GROQ_MODEL=llama-3.3-70b-versatile

# Local embedding model used to convert text into vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum accepted PDF file size, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# Number of characters in each text chunk.
CHUNK_SIZE=1000

# Number of overlapping characters between consecutive chunks.
CHUNK_OVERLAP=200